# Momentum — Supabase configuration
#
# Copy this file to `.env.local` and fill in the values from your Supabase project:
#   Supabase Dashboard → Project Settings → API
#
# NOTE: The app runs out-of-the-box WITHOUT these values using rich in-memory
# mock data (great for a first look / demo). Provide these to switch to a real
# Supabase-backed database.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
