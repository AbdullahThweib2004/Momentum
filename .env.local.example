# Momentum — Supabase configuration
#
# Copy this file to `.env.local` and fill in the values from your Supabase project:
#   Supabase Dashboard → Project Settings → API
#
# NOTE: The app runs out-of-the-box WITHOUT these values using rich in-memory
# mock data (great for a first look / demo). Provide these to switch to a real
# Supabase-backed database.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# --- AI generation (optional) ---
# Momentum generates post drafts via OpenRouter (OpenAI-compatible API).
# Get a key at https://openrouter.ai/keys. Server-side only — never exposed to
# the browser. If this is missing or the API fails/rate-limits, the app falls
# back to a built-in mock generator, so the feature always works.
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key
# Optional: comma-separated models, tried in order until one succeeds.
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free,openai/gpt-oss-20b:free
